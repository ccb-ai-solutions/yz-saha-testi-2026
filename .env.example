# Copy to .env (never commit .env).  Only variable NAMES are stored in results — never the values.
# Nothing is called until you run a command with --yes (see README "Spend gate").

# --- EVREN (Track A; free until 2026-11-01)
EVREN_API_KEY=

# --- hosted open-weight models (Track H)
OVHC_API_KEY=                     # OVHcloud AI Endpoints (Bearer)
OLLAMA_API_KEY=                   # Ollama Cloud (Free plan = 1 request in flight)
AWS_BEARER_TOKEN_BEDROCK=         # Amazon Bedrock API key (Chat Completions + InvokeModel)
AWS_REGION=us-east-1              # Magistral / Nemotron / gpt-oss-safeguard availability differs by region
# NVIDIA API Catalog (build.nvidia.com): free trial endpoints, ~40 requests/min; internal evaluation only
NVIDIA_API_KEY=
# Mistral AI's own API (EU): the only hosted route to Mistral Small 4 (console.mistral.ai, pay as you go)
MISTRAL_API_KEY=

# --- judge (configs/judge.yaml → judge-anthropic)
ANTHROPIC_API_KEY=
# JUDGE_ANTHROPIC_MODEL=claude-opus-5-5          # default; the calibration pass uses claude-sonnet-5-5
# JUDGE_ANTHROPIC_SONNET_MODEL=claude-sonnet-5-5

# --- our own practice deployment on OVHcloud GPUs (phase 6, deploy/OVH_V100S_RUNBOOK.md)
# OVH_DEPLOY_BASE_URL=http://127.0.0.1:8000/v1   # through the SSH tunnel
# OVH_DEPLOY_TOKEN=                              # the --api-key you gave vLLM / llama-server
# OVH_DEPLOY_MODEL=magistral-small-1.2           # the served model name
# OVH_DEPLOY_HARDWARE=OVH t2-90, 2x V100S 32GB, vLLM 0.x fp16, TP=2

# --- optional references (not part of the lineup)
# OPENAI_API_KEY=
# OPENAI_CHAT_MODEL=
# ANTHROPIC_CHAT_MODEL=

# --- on-prem / closed network (Track B, client sites)
# LOCAL_BASE_URL=http://localhost:8000/v1
# LOCAL_API_KEY=
# LOCAL_CHAT_MODEL=
# LOCAL_HARDWARE=e.g. 2x RTX PRO 6000 Blackwell 96GB, vLLM 0.x, fp8
# JUDGE_LOCAL_MODEL=
# TRBENCH_OFFLINE=1            # refuse every non-private endpoint (same as policy.offline: true)

# --- data downloads (Hugging Face; only if a dataset requires login)
# HF_TOKEN=
